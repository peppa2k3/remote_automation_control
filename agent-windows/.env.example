AGENT_API_BASE_URL=http://localhost:4000/api/v1
AGENT_ALLOW_LOCAL_HTTP=true
AGENT_REQUEST_TIMEOUT_MS=5000
# Optional absolute parent directory. Only its device-identity subfolder is used.
# Default: %LOCALAPPDATA%/AutomationControl (DPAPI CurrentUser; never put tokens in env).
# AGENT_STATE_DIR=D:/AutomationData
# Future worker prompts (no device token/ID in env):
# AGENT_DATA_DIR=D:\AutomationData
# AGENT_MAX_CONCURRENT_DOWNLOADS=2
# AGENT_MAX_CONCURRENT_MEDIA_JOBS=1
# AGENT_POLL_SECONDS=10
