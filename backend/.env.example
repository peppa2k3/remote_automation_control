NODE_ENV=development
HOST=127.0.0.1
PORT=4000
FRONTEND_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://automation:<LOCAL_PASSWORD>@localhost:5432/automation
LOG_LEVEL=info
AUTH_SESSION_SECONDS=1800
AUTH_ABSOLUTE_SECONDS=28800
# Future prompts only; never use these placeholders as secrets.
# AUTH_SESSION_SECRET=<RANDOM_SECRET>
# ENCRYPTION_KEY=<BASE64_32_BYTE_KEY>
# META_GRAPH_API_VERSION=<VERIFY_SUPPORTED_VERSION>
# S3_ENDPOINT=https://storage.example.com
