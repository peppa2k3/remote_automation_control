generator client {
  provider = "prisma-client"
  output = "../src/generated/prisma"
  moduleFormat = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

model SystemCheck {
  id        String   @id @default(uuid()) @db.Uuid
  label     String   @unique
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
}

enum UserRole {
  OWNER
  ADMIN
  VIEWER
}

enum UserStatus {
  ACTIVE
  DISABLED
}

model User {
  id           String      @id @default(uuid()) @db.Uuid
  email        String      @unique
  passwordHash String
  role         UserRole    @default(VIEWER)
  status       UserStatus  @default(ACTIVE)
  mfaEnabled   Boolean     @default(false)
  createdAt    DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime    @updatedAt @db.Timestamptz(3)
  sessions     AuthSession[]
  pairingCodes PairingCode[]
  @@map("users")
}

model AuthSession {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @db.Uuid
  tokenHash         String    @unique @db.Char(64)
  expiresAt         DateTime  @db.Timestamptz(3)
  absoluteExpiresAt DateTime  @db.Timestamptz(3)
  revokedAt         DateTime? @db.Timestamptz(3)
  createdAt         DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @db.Timestamptz(3)
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("auth_sessions")
}

model AuthThrottle {
  key       String   @id @db.Char(64)
  count     Int
  resetAt   DateTime @db.Timestamptz(3)
  @@index([resetAt])
  @@map("auth_throttles")
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  actorId   String?  @db.Uuid
  action    String
  targetId  String?  @db.Uuid
  requestId String   @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  @@index([createdAt, id])
  @@index([actorId, createdAt])
  @@map("audit_logs")
}

model PairingCode {
  id        String    @id @default(uuid()) @db.Uuid
  codeHash  String    @unique @db.Char(64)
  createdBy String    @db.Uuid
  expiresAt DateTime  @db.Timestamptz(3)
  usedAt    DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  owner     User      @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  @@index([expiresAt])
  @@map("pairing_codes")
}

model Device {
  id           String    @id @default(uuid()) @db.Uuid
  label        String
  platform     String
  arch         String
  version      String
  capabilities String[]
  lastSeenAt   DateTime? @db.Timestamptz(3)
  revokedAt    DateTime? @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @db.Timestamptz(3)
  credentials  DeviceCredential[]
  @@index([lastSeenAt])
  @@map("devices")
}

model DeviceCredential {
  id               String    @id @default(uuid()) @db.Uuid
  deviceId         String    @db.Uuid
  tokenHash        String    @unique @db.Char(64)
  scopes           String[]
  expiresAt        DateTime  @db.Timestamptz(3)
  activatedAt      DateTime? @db.Timestamptz(3)
  pendingExpiresAt DateTime? @db.Timestamptz(3)
  rotationParentId String?   @unique @db.Uuid
  revokedAt        DateTime? @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @db.Timestamptz(3)
  device           Device    @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  @@index([deviceId, revokedAt])
  @@index([expiresAt])
  @@map("device_credentials")
}
